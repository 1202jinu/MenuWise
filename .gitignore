# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.venv/
venv/

# ===== 환경변수 / 비밀키 (절대 커밋 금지) =====
.env
.env.*
# .env.example 템플릿은 커밋 허용
!.env.example
*.key
*.pem
*.p12
secrets.json
credentials.json
# 프론트 구글맵 키 주입 파일(사용 시)
**/maps_key.js

# ===== 데이터베이스 / 스크래핑 데이터 =====
*.db
*.sqlite
*.sqlite3
menu_wise.db

# ===== 크롤러 산출물 =====
# 실제 Google API 키가 photo URL(&key=AIza...)에 포함되어 있어 반드시 무시
crawler/google_crawl_preview.txt
# 대용량 원본 덤프(현재 파이프라인 미사용)
crawler/apify_reviews.json
crawler/google_place_candidates.txt
# 참고: crawler/ai_crawl_input.txt 는 파이프라인 입력 데이터(키 없음)라 커밋 대상으로 남겨둠

# ===== Flutter 빌드/도구 산출물 =====
# (frontend/.gitignore가 처리하지만 루트에서도 방어적으로 무시)
frontend/build/
frontend/.dart_tool/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies

# ===== IDE / OS =====
.vscode/
.idea/
*.iml
.DS_Store
Thumbs.db

# ===== 추가 방어: 키 유출 예방 하드닝 =====
# 로그/백업에 키가 찍힐 수 있어 무시
*.log
*.bak
*.tmp
# 크롤러 미리보기/후보 덤프는 photo URL 쿼리스트링에 Google API 키가 섞일 수 있어 패턴으로 차단
# (ai_crawl_input*.txt 입력 데이터는 키가 없어 커밋 대상으로 유지됨)
crawler/*_preview.txt
crawler/*_candidates.txt
# 일반 비밀 파일 패턴(파일명에 secret/credential 포함 시)
*secret*.json
*credential*.json
*token*.json
